# ==============================================================================
# TrustLens Environment Configuration
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# --- MySQL Database Configuration ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=trustlens_db
MYSQL_USER=trustlens_user
MYSQL_PASSWORD=trustlens_secret
MYSQL_ROOT_PASSWORD=root_secret

# --- Redis Cache & Rate Limiting ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Backend Security & JWT ---
# 256-bit secret key in base64 / hex format
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# --- Microservices Communication ---
# URL of the AI inference microservice
AI_SERVICE_URL=http://ai-service:8000

# --- Chatbot Free LLM Configuration ---
# Optional: Get a free API key at https://console.groq.com/keys
# If left empty, TrustLens automatically uses its built-in rule-based explanation engine.
GROQ_API_KEY=

# --- Frontend API Endpoint ---
# Used by the browser frontend to talk to Spring Boot backend
VITE_API_URL=http://localhost:8080
